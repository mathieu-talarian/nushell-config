# Standalone regenerator for _loader.nu. Run directly:
#   nu ~/.config/nushell/conf.d/completions/_regen.nu
# It rebuilds _loader.nu from the *.nu files actually present (so it self-heals:
# references to deleted files are pruned). This is the recovery hatch if a manual
# deletion ever leaves _loader.nu pointing at a missing file and config won't load.

const DIR = path self | path dirname
let loader = ($DIR | path join "_loader.nu")

let files = (
    glob ($DIR | path join "*.nu")
    | where {|f| ($f | path basename) not-in ["_loader.nu" "_regen.nu"] }
    | sort
)

let body = ($files | each {|f| $'use "($f)" *' } | str join (char nl))

[
    "# AUTO-GENERATED by completions-reload / _regen.nu. Do not edit by hand."
    "# Each line below brings one nu_scripts completion file into scope."
    $body
    ""
] | str join (char nl) | save -f $loader

print $"Loader regenerated: ($files | length) completion file\(s\)."
